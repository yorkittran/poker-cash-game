<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-white mb-2">Your Statistics</h1>
    <p class="text-gray-400">Track your poker performance</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white/5 backdrop-blur-xl rounded-2xl border border-white/10 p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 bg-gradient-to-br from-amber-400 to-amber-600 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
      </div>
      <p class="text-gray-400 text-sm mb-1">Total Bankroll</p>
      <p class="text-3xl font-bold text-white">$<%= number_with_delimiter(@total_bankroll) %></p>
    </div>

    <div class="bg-white/5 backdrop-blur-xl rounded-2xl border border-white/10 p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 bg-gradient-to-br from-<%= @total_profit >= 0 ? 'emerald' : 'red' %>-400 to-<%= @total_profit >= 0 ? 'emerald' : 'red' %>-600 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= @total_profit >= 0 ? 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6' : 'M13 17h8m0 0V9m0 8l-8-8-4 4-6-6' %>"/>
          </svg>
        </div>
      </div>
      <p class="text-gray-400 text-sm mb-1">Total Profit/Loss</p>
      <p class="text-3xl font-bold <%= @total_profit >= 0 ? 'text-emerald-400' : 'text-red-400' %>">
        <%= @total_profit >= 0 ? '+' : '' %>$<%= number_with_delimiter(@total_profit) %>
      </p>
    </div>

    <div class="bg-white/5 backdrop-blur-xl rounded-2xl border border-white/10 p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 bg-gradient-to-br from-violet-400 to-violet-600 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
        </div>
      </div>
      <p class="text-gray-400 text-sm mb-1">Games Played</p>
      <p class="text-3xl font-bold text-white"><%= @total_games %></p>
    </div>

    <div class="bg-white/5 backdrop-blur-xl rounded-2xl border border-white/10 p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 bg-gradient-to-br from-blue-400 to-blue-600 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
          </svg>
        </div>
      </div>
      <p class="text-gray-400 text-sm mb-1">Hands Won</p>
      <p class="text-3xl font-bold text-white"><%= @total_hands_won %></p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="lg:col-span-2 bg-white/5 backdrop-blur-xl rounded-2xl border border-white/10 overflow-hidden">
      <div class="p-6 border-b border-white/10">
        <h2 class="text-xl font-semibold text-white">Recent Sessions</h2>
      </div>

      <% if @cash_sessions.any? %>
        <div class="divide-y divide-white/10">
          <% @cash_sessions.each do |session| %>
            <div class="p-6 hover:bg-white/5 transition-colors">
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="text-white font-medium"><%= session.game.name %></h3>
                  <p class="text-gray-500 text-sm">
                    <%= session.ended_at ? time_ago_in_words(session.ended_at) + ' ago' : 'In progress' %>
                    · <%= session.hands_played %> hands
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-lg font-semibold <%= session.profit_loss && session.profit_loss >= 0 ? 'text-emerald-400' : 'text-red-400' %>">
                    <%= session.profit_loss ? (session.profit_loss >= 0 ? '+' : '') + '$' + number_with_delimiter(session.profit_loss) : '-' %>
                  </p>
                  <p class="text-gray-500 text-sm">
                    Buy-in: $<%= number_with_delimiter(session.buyin) %>
                    <% if session.cashout %>
                      → $<%= number_with_delimiter(session.cashout) %>
                    <% end %>
                  </p>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="p-12 text-center">
          <div class="w-16 h-16 bg-white/5 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">No Sessions Yet</h3>
          <p class="text-gray-400 mb-4">Play your first game to see your statistics!</p>
          <%= link_to "Find a Table", games_path, class: "inline-flex items-center px-6 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white font-semibold rounded-xl transition-all" %>
        </div>
      <% end %>
    </div>

    <div class="bg-white/5 backdrop-blur-xl rounded-2xl border border-white/10 p-6">
      <h2 class="text-xl font-semibold text-white mb-6">Performance</h2>

      <div class="space-y-6">
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-gray-400 text-sm">Win Rate</span>
            <span class="text-white font-semibold"><%= @win_rate %>%</span>
          </div>
          <div class="h-3 bg-white/10 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-emerald-400 to-emerald-600 rounded-full transition-all"
                 style="width: <%= [@win_rate, 100].min %>%"></div>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-gray-400 text-sm">Profitable Sessions</span>
            <span class="text-white font-semibold"><%= @profitable_sessions.count %>/<%= @cash_sessions.count %></span>
          </div>
          <div class="h-3 bg-white/10 rounded-full overflow-hidden">
            <% profitable_rate = @cash_sessions.count > 0 ? (@profitable_sessions.count.to_f / @cash_sessions.count * 100) : 0 %>
            <div class="h-full bg-gradient-to-r from-amber-400 to-amber-600 rounded-full transition-all"
                 style="width: <%= profitable_rate %>%"></div>
          </div>
        </div>

        <div class="pt-4 border-t border-white/10">
          <div class="flex items-center justify-between">
            <span class="text-gray-400">Avg per Session</span>
            <% avg_profit = @cash_sessions.count > 0 ? (@total_profit.to_f / @cash_sessions.count).round : 0 %>
            <span class="font-semibold <%= avg_profit >= 0 ? 'text-emerald-400' : 'text-red-400' %>">
              <%= avg_profit >= 0 ? '+' : '' %>$<%= number_with_delimiter(avg_profit) %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

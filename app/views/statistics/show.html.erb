<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center space-x-4 mb-8">
    <%= link_to statistics_path, class: "p-2 hover:bg-white/10 rounded-lg transition-colors" do %>
      <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
    <% end %>
    <div>
      <h1 class="text-3xl font-bold text-white"><%= @game.name %></h1>
      <p class="text-gray-400">Game History & Hand Replay</p>
    </div>
  </div>

  <% if @my_sessions.any? %>
    <div class="bg-white/5 backdrop-blur-xl rounded-2xl border border-white/10 p-6 mb-8">
      <h2 class="text-lg font-semibold text-white mb-4">Your Sessions in This Game</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <% @my_sessions.each do |session| %>
          <div class="bg-white/5 rounded-xl p-4 border border-white/10">
            <div class="flex items-center justify-between mb-2">
              <span class="text-gray-400 text-sm">
                <%= session.ended_at ? time_ago_in_words(session.ended_at) + ' ago' : 'Ongoing' %>
              </span>
              <span class="font-semibold <%= session.profit_loss && session.profit_loss >= 0 ? 'text-emerald-400' : 'text-red-400' %>">
                <%= session.profit_loss ? (session.profit_loss >= 0 ? '+' : '') + '$' + number_with_delimiter(session.profit_loss) : 'Active' %>
              </span>
            </div>
            <div class="text-sm text-gray-400">
              Buy-in: <%= number_with_delimiter(session.buyin) %>
              <% if session.cashout %>
                → Cash-out: <%= number_with_delimiter(session.cashout) %>
              <% end %>
            </div>
            <div class="text-sm text-gray-400 mt-1">
              <%= session.hands_played %> hands played
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="bg-white/5 backdrop-blur-xl rounded-2xl border border-white/10 overflow-hidden">
    <div class="p-6 border-b border-white/10">
      <h2 class="text-xl font-semibold text-white">Hand History</h2>
      <p class="text-gray-400 text-sm mt-1"><%= @hands.count %> completed hands</p>
    </div>

    <% if @hands.any? %>
      <div class="divide-y divide-white/10">
        <% @hands.each do |hand| %>
          <div class="p-6">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3 class="text-white font-semibold">Hand #<%= hand.hand_number %></h3>
                <p class="text-gray-500 text-sm"><%= time_ago_in_words(hand.completed_at) %> ago</p>
              </div>
              <div class="text-right">
                <p class="text-amber-400 font-semibold">Pot: <%= number_with_delimiter(hand.pot) %></p>
              </div>
            </div>

            <% if hand.community_cards.present? %>
              <div class="mb-4">
                <p class="text-gray-500 text-xs uppercase tracking-wider mb-2">Community Cards</p>
                <div class="flex space-x-1">
                  <% hand.community_cards.each do |card| %>
                    <%= render partial: 'games/card', locals: { card: card, small: true } %>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if hand.winners.present? %>
              <div class="mb-4">
                <p class="text-gray-500 text-xs uppercase tracking-wider mb-2">Winner(s)</p>
                <div class="flex flex-wrap gap-2">
                  <% hand.winners.each do |winner| %>
                    <div class="inline-flex items-center space-x-2 px-3 py-1 bg-emerald-500/20 rounded-lg border border-emerald-500/30">
                      <span class="text-emerald-400 font-medium"><%= winner['username'] %></span>
                      <span class="text-emerald-400/60">+<%= number_with_delimiter(winner['amount']) %></span>
                      <span class="text-emerald-400/40 text-sm">(<%= winner['hand_name'] %>)</span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if hand.player_actions.any? %>
              <details class="group">
                <summary class="flex items-center cursor-pointer text-gray-400 hover:text-white transition-colors">
                  <svg class="w-4 h-4 mr-2 transform group-open:rotate-90 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  <span class="text-sm">View Actions (<%= hand.player_actions.count %>)</span>
                </summary>

                <div class="mt-3 pl-6 space-y-2">
                  <% hand.player_actions.order(:created_at).each do |action| %>
                    <div class="flex items-center space-x-3 text-sm">
                      <span class="text-gray-500 capitalize w-16"><%= action.round %></span>
                      <span class="text-white font-medium w-24"><%= action.user.username %></span>
                      <span class="px-2 py-0.5 rounded text-xs font-medium
                                   <%= case action.action_type
                                       when 'fold' then 'bg-red-500/20 text-red-400'
                                       when 'check' then 'bg-blue-500/20 text-blue-400'
                                       when 'call' then 'bg-emerald-500/20 text-emerald-400'
                                       when 'raise', 'bet' then 'bg-amber-500/20 text-amber-400'
                                       when 'all_in' then 'bg-purple-500/20 text-purple-400'
                                       else 'bg-gray-500/20 text-gray-400'
                                       end %>">
                        <%= action.action_type.humanize %>
                        <% if action.amount && action.amount > 0 %>
                          <%= action.amount %>
                        <% end %>
                      </span>
                    </div>
                  <% end %>
                </div>
              </details>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-12 text-center">
        <div class="w-16 h-16 bg-white/5 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">No Completed Hands</h3>
        <p class="text-gray-400">Hands will appear here once they're completed.</p>
      </div>
    <% end %>
  </div>
</div>

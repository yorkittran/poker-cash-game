<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Poker Cash Game" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-gradient-to-br from-slate-900 via-emerald-950 to-slate-900 font-['Outfit']">
    <% if user_signed_in? %>
      <nav class="fixed top-0 left-0 right-0 z-50 bg-black/40 backdrop-blur-xl border-b border-emerald-500/20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between h-16">
            <div class="flex items-center space-x-8">
              <%= link_to root_path, class: "flex items-center space-x-3 group" do %>
                <div class="w-10 h-10 bg-gradient-to-br from-emerald-400 to-emerald-600 rounded-xl flex items-center justify-center shadow-lg shadow-emerald-500/25 group-hover:shadow-emerald-500/40 transition-all">
                  <span class="text-white font-bold text-lg">♠</span>
                </div>
                <span class="text-white font-bold text-xl tracking-tight">PokerCash</span>
              <% end %>

              <div class="hidden md:flex items-center space-x-1">
                <%= link_to "Lobby", games_path, class: "px-4 py-2 rounded-lg text-sm font-medium transition-all #{request.path == games_path ? 'bg-emerald-500/20 text-emerald-400' : 'text-gray-300 hover:text-white hover:bg-white/5'}" %>
                <%= link_to "Statistics", statistics_path, class: "px-4 py-2 rounded-lg text-sm font-medium transition-all #{request.path == statistics_path ? 'bg-emerald-500/20 text-emerald-400' : 'text-gray-300 hover:text-white hover:bg-white/5'}" %>
              </div>
            </div>

            <div class="flex items-center space-x-4">
              <div class="hidden sm:flex items-center space-x-3 px-4 py-2 bg-white/5 rounded-xl border border-white/10">
                <div class="w-8 h-8 bg-gradient-to-br from-amber-400 to-amber-600 rounded-lg flex items-center justify-center">
                  <span class="text-white text-xs font-bold">$</span>
                </div>
                <div>
                  <p class="text-xs text-gray-400">Bankroll</p>
                  <p class="text-white font-semibold"><%= number_with_delimiter(current_user.total_bankroll) %></p>
                </div>
              </div>

              <div class="relative group">
                <button class="flex items-center space-x-2 px-3 py-2 rounded-xl hover:bg-white/5 transition-all">
                  <div class="w-8 h-8 bg-gradient-to-br from-violet-500 to-purple-600 rounded-lg flex items-center justify-center">
                    <span class="text-white font-bold text-sm"><%= current_user.username[0].upcase %></span>
                  </div>
                  <span class="text-white font-medium hidden sm:block"><%= current_user.username %></span>
                  <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>

                <div class="absolute right-0 mt-2 w-48 py-2 bg-slate-800 rounded-xl shadow-xl border border-white/10 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all">
                  <div class="px-4 py-2 border-b border-white/10">
                    <p class="text-sm text-gray-400">Signed in as</p>
                    <p class="text-white font-medium truncate"><%= current_user.username %></p>
                  </div>
                  <%= link_to "Statistics", statistics_path, class: "block px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/5" %>
                  <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "w-full text-left px-4 py-2 text-sm text-red-400 hover:text-red-300 hover:bg-red-500/10" %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </nav>
    <% end %>

    <main class="<%= user_signed_in? ? 'pt-20' : '' %> min-h-full">
      <% if notice %>
        <div class="fixed top-20 left-1/2 -translate-x-1/2 z-50 animate-fade-in">
          <div class="px-6 py-3 bg-emerald-500/20 border border-emerald-500/30 rounded-xl backdrop-blur-xl">
            <p class="text-emerald-400 font-medium"><%= notice %></p>
          </div>
        </div>
      <% end %>

      <% if alert %>
        <div class="fixed top-20 left-1/2 -translate-x-1/2 z-50 animate-fade-in">
          <div class="px-6 py-3 bg-red-500/20 border border-red-500/30 rounded-xl backdrop-blur-xl">
            <p class="text-red-400 font-medium"><%= alert %></p>
          </div>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
